# Copie para .env.local e preencha. Nunca versione .env.local.
#
# Supabase local: `pnpm exec supabase status` mostra os valores.
# Supabase nuvem: Project Settings → API Keys.

# URL do projeto (pública)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave "publishable" (pública; o acesso é limitado pelo RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Chave "secret" (PRIVILEGIADA — ignora RLS). Só no servidor, nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
